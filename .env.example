# Backend
PORT=3001
NODE_ENV=development

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Gemini API (required for Phase 3+)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=

# Crawl settings
CRAWL_DELAY_MS=2000
CRAWL_CONCURRENCY=2
CRAWL_TIMEOUT_MS=30000

# Paths (relative to backend/)
DB_PATH=./data/legalreach.db
LOG_PATH=./logs
OUTPUT_PATH=./output