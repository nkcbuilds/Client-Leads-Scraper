# Backend
PORT=3001
NODE_ENV=development

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Gemini API (required for Phase 3+)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=

# Crawl settings
CRAWL_DELAY_MS=2000
CRAWL_DELAY_MIN_MS=1500
CRAWL_DELAY_MAX_MS=3500
CRAWL_CONCURRENCY=2
CRAWL_TIMEOUT_MS=30000

# Browser / Cloudflare bypass
BROWSER_STEALTH=true
BROWSER_USE_SYSTEM_CHROME=true
BROWSER_HEADLESS=true
BROWSER_WARMUP=true
BROWSER_WARMUP_WAIT_MS=8000
BROWSER_STORAGE_STATE_DIR=./data/browser-sessions
BROWSER_HUMAN_BEHAVIOR=true
BROWSER_REPLAY_COOKIES=true
# chrome-native = system Chrome TLS fingerprint; chromium-bundled = Playwright Chromium
BROWSER_TLS_MODE=chrome-native

# Tip: set BROWSER_HEADLESS=false if a site still blocks headless Chrome

# Paths (relative to backend/)
DB_PATH=./data/legalreach.db
LOG_PATH=./logs
OUTPUT_PATH=./output